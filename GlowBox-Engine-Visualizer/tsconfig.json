{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["src/engine/*"],
      "@animation/*": ["src/animation/*"],
      "@layers/*": ["src/layers/*"],
      "@store/*": ["src/store/*"],
      "@ui/*": ["src/ui/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}