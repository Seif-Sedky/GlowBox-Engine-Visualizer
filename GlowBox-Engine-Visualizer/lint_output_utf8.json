 <InvertedLayer />\n      case 'skiplist': return <SkipListLayer />\n      case 'lsmtree': return <LsmTreeLayer />\n      default:\n        return <IndexLayer />\n    }\n  }\n\n  return (\n    <div className={styles.root} data-theme={theme}>\n      <Navbar />\n\n      <button \n        className={`glass glass-hover ${styles.mechanismBtn}`}\n        onClick={() => setShowMechanism(true)}\n        title=\"How it Works\"\n      >\n        <span className={styles.mechanismIcon}>≡ƒÆí</span>\n        <span className={styles.mechanismText}>How it Works</span>\n      </button>\n\n      {showMechanism && <MechanismModal onClose={() => setShowMechanism(false)} />}\n\n      {/* ΓöÇΓöÇ Main canvas area ΓöÇΓöÇ */}\n      <main className={styles.main}>\n        {renderLayer()}\n        <AnnotationPopup />\n      </main>\n\n      <BottomControls />\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Seif\\OneDrive\\Documents\\GitHub\\GlowBox-Engine-Visualizer\\GlowBox-Engine-Visualizer\\src\\ui\\shell\\loreData.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Seif\\OneDrive\\Documents\\GitHub\\GlowBox-Engine-Visualizer\\GlowBox-Engine-Visualizer\\src\\ui\\shell\\mechanismData.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Seif\\OneDrive\\Documents\\GitHub\\GlowBox-Engine-Visualizer\\GlowBox-Engine-Visualizer\\src\\vite-env.d.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Seif\\OneDrive\\Documents\\GitHub\\GlowBox-Engine-Visualizer\\GlowBox-Engine-Visualizer\\vite.config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCoun